<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda7_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1C1C1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/agenda7_widget_label"
            android:text="AGENDA REKTOR"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/agenda7_range_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7 Hari ke Depan"
            android:textColor="#A1A1AA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Scrollable ListView -->
    <ListView
        android:id="@+id/agenda7_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/agenda7_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tidak ada agenda 7 hari ke depan"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:visibility="gone"
        android:paddingTop="8dp" />

</LinearLayout>
