<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda7_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1C1C1E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/agenda7_widget_label"
            android:text="AGENDARECAP PRO"
            android:textColor="#3B82F6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/agenda7_range_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7 Hari ke Depan"
            android:textColor="#A1A1AA"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Item 1 -->
    <LinearLayout
        android:id="@+id/agenda7_item1_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/agenda7_item1_date"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="Hari ini"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/agenda7_item1_time"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="08:30"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda7_item1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agenda 1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Item 2 -->
    <LinearLayout
        android:id="@+id/agenda7_item2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda7_item2_date"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/agenda7_item2_time"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda7_item2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agenda 2"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Item 3 -->
    <LinearLayout
        android:id="@+id/agenda7_item3_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda7_item3_date"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/agenda7_item3_time"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="14:00"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda7_item3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agenda 3"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Item 4 -->
    <LinearLayout
        android:id="@+id/agenda7_item4_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda7_item4_date"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/agenda7_item4_time"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda7_item4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agenda 4"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Item 5 -->
    <LinearLayout
        android:id="@+id/agenda7_item5_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda7_item5_date"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/agenda7_item5_time"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda7_item5_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agenda 5"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- More indicator -->
    <TextView
        android:id="@+id/agenda7_more_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ lebih banyak..."
        android:textColor="#60A5FA"
        android:textSize="10sp"
        android:visibility="gone"
        android:paddingTop="2dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/agenda7_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tidak ada agenda 7 hari ke depan"
        android:textColor="#71717A"
        android:textSize="11sp"
        android:visibility="gone"
        android:paddingTop="4dp" />

</LinearLayout>
